{
  "name": "stp-generation3-overlay",
  "version": "1.2.0",
  "description": "Scott's Thoughts Overlay.",
  "main": "./main.js",
  "build": {
    "appId": "com.stp-generation3-overlay",
    "productName": "stp-generation3-overlay",
    "win": {
      "executableName": "stp-generation3-overlay",
      "target": "zip",
      "icon": "./icon.ico"
    },
    "linux": {
      "target": ["AppImage", "pacman"],
      "category": "Utility",
      "icon": "./icon.png"
    },
    "npmRebuild": false
  },
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder --win --config",
    "build:linux": "electron-builder --linux"

  },
  "devDependencies": {
    "electron": "^25.1.1",
    "electron-builder": "^24.4.0"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^1.0.2"
  }
}
